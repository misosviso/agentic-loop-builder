{
  "name": "development-loop",
  "description": "Develop a Jira story end to end: requirements, subtasks, implement and review, then a pull request.",
  "inputs": {
    "story": "Jira issue key, e.g. PROJ-123"
  },
  "defaults": {
    "run_in_subagent": true,
    "max_iterations": 3,
    "max_fix_attempts": 3
  },
  "requires": {
    "commands": [
      "git"
    ]
  },
  "orchestrator": {
    "model": "inherit",
    "color": "blue"
  },
  "subagents": {
    "development-loop-jira": {
      "description": "Fetches a Jira issue with its links and discussion into a Markdown file. Read-only towards Jira and the code.",
      "model": "haiku",
      "disallowedTools": [
        "Edit",
        "NotebookEdit",
        "Agent"
      ]
    },
    "development-loop-implementer": {
      "description": "Implements one well-specified coding subtask with tests, verifies it and commits it. Never pushes.",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Glob",
        "Grep",
        "Bash"
      ]
    }
  },
  "schemas": {
    "subtask": {
      "type": "object",
      "required": [
        "id",
        "title",
        "goal",
        "depends_on",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "review_verdict": {
      "type": "object",
      "required": [
        "verdict",
        "blockers"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "PASS_WITH_NITS",
            "CHANGES_NEEDED"
          ]
        },
        "blockers": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        }
      }
    }
  },
  "steps": [
    {
      "id": "jira_context",
      "kind": "single",
      "skill": "steps/jira-context.md",
      "subagent_type": "development-loop-jira",
      "artifacts": [
        {
          "path": "jira-context.md",
          "sections": [
            "## Metadata",
            "## Description",
            "## Acceptance criteria",
            "## Linked issues",
            "## Open questions"
          ]
        }
      ]
    },
    {
      "id": "requirements",
      "kind": "single",
      "skill": "steps/requirements.md",
      "needs": [
        "jira_context"
      ],
      "artifacts": [
        {
          "path": "requirements.md",
          "sections": [
            "## Summary",
            "## Scope",
            "## Functional requirements",
            "## Assumptions",
            "## Open questions"
          ],
          "contains": [
            "\\bR1\\b"
          ]
        }
      ],
      "gate": {
        "id": "G1",
        "prompt": "Read requirements.md. Approve if it captures the story correctly and completely; otherwise reject and say what is wrong or missing."
      }
    },
    {
      "id": "decomposition",
      "kind": "single",
      "skill": "steps/decompose.md",
      "needs": [
        "requirements"
      ],
      "inputs": [
        "jira_context",
        "requirements"
      ],
      "artifacts": [
        "subtasks.json",
        {
          "path": "plan.md",
          "sections": [
            "## Overview",
            "## Subtasks",
            "## Coverage"
          ]
        }
      ],
      "produces_items": {
        "file": "subtasks.json",
        "key": "subtasks",
        "item_schema": "subtask"
      },
      "gate": {
        "id": "G2",
        "prompt": "Review plan.md and subtasks.json: is each subtask small, ordered correctly, and verifiable? Approve, or reject with the changes you want."
      }
    },
    {
      "id": "subtasks",
      "kind": "foreach",
      "over": "decomposition",
      "inputs": [
        "requirements",
        "decomposition"
      ],
      "respect_item_dependencies": true,
      "max_iterations": 3,
      "cycle": [
        {
          "id": "implement",
          "skill": "steps/implement.md",
          "subagent_type": "development-loop-implementer",
          "artifacts": [
            {
              "path": "subtasks/{item}/implementation.md",
              "sections": [
                "## Changes",
                "## Verification",
                "## Commit"
              ],
              "contains": [
                "\\b[0-9a-f]{7,40}\\b"
              ]
            }
          ],
          "checks": [
            {
              "name": "changes are committed",
              "run": "test -z \"$(git status --porcelain --untracked-files=no)\""
            }
          ],
          "requires": {
            "commands": [
              "git"
            ]
          }
        },
        {
          "id": "review",
          "skill": "steps/review.md",
          "agents": [
            {
              "id": "correctness",
              "focus": "Correctness: bugs, edge cases, error handling, security, and fit with the codebase's conventions. Read the diff line by line."
            },
            {
              "id": "verification",
              "focus": "Verification: re-run every verification point and the touched tests yourself, and judge whether the tests actually prove the subtask's goal (missing cases, weak assertions)."
            }
          ],
          "artifacts": [
            {
              "path": "subtasks/{item}/review-{agent}.md",
              "sections": [
                "## Verdict",
                "## Findings"
              ]
            },
            {
              "path": "subtasks/{item}/review-{agent}.json",
              "json_schema": "review_verdict"
            }
          ],
          "repeat": {
            "until": {
              "all": [
                {
                  "file": "subtasks/{item}/review-correctness.json",
                  "field": "verdict",
                  "not_equals": "CHANGES_NEEDED"
                },
                {
                  "file": "subtasks/{item}/review-verification.json",
                  "field": "verdict",
                  "not_equals": "CHANGES_NEEDED"
                }
              ]
            },
            "back_to": "implement",
            "max": 3,
            "on_exhausted": "gate"
          },
          "gate": {
            "id": "G3",
            "on_reject": "implement",
            "prompt": "Two reviewers (correctness, verification) passed this subtask, or gave up after 3 automatic rounds (the summary says so). Read their reviews, and the diff if you want. Approve to move on, or reject with feedback to send it back to implementation."
          }
        }
      ]
    },
    {
      "id": "open_pr",
      "kind": "single",
      "skill": "steps/open-pr.md",
      "needs": [
        "subtasks"
      ],
      "inputs": [
        "jira_context",
        "requirements",
        "subtasks"
      ],
      "artifacts": [
        {
          "path": "pr.md",
          "sections": [
            "## Pull request"
          ],
          "contains": [
            "https?://\\S+/pull/\\d+"
          ]
        }
      ],
      "gate": {
        "id": "G4",
        "when": "before",
        "prompt": "All subtasks are approved. Approve to push the branch and open the pull request.",
        "guard": {
          "tool": "Bash",
          "pattern": "gh\\s+pr\\s+create"
        }
      },
      "requires": {
        "commands": [
          "gh",
          "git"
        ]
      }
    },
    {
      "id": "fix_ci",
      "kind": "single",
      "skill": "steps/fix-ci.md",
      "description": "Runs only after CI failed on the pull request; the CI wait sends the run back here.",
      "subagent_type": "development-loop-implementer",
      "when": {
        "file": "ci.status.json",
        "field": "status",
        "equals": "failed"
      },
      "needs": [
        "open_pr"
      ],
      "inputs": [
        "requirements",
        "open_pr"
      ],
      "artifacts": [
        {
          "path": "ci-fix.md",
          "sections": [
            "## Failure",
            "## Fix",
            "## Commit"
          ]
        }
      ],
      "checks": [
        {
          "name": "fix is committed and pushed",
          "run": "test -z \"$(git status --porcelain --untracked-files=no)\" && test -z \"$(git log @{u}..HEAD --oneline)\""
        }
      ],
      "requires": {
        "commands": [
          "git"
        ]
      },
      "max_iterations": 3
    },
    {
      "id": "ci",
      "kind": "single",
      "needs": [
        "fix_ci"
      ],
      "wait": {
        "description": "CI checks on the pull request",
        "check": {
          "run": "sh .claude/skills/development-loop/scripts/ci_status.sh",
          "failed_exit_codes": [
            1
          ]
        },
        "poll_every": "3m",
        "timeout": "2h",
        "on_failure": {
          "back_to": "fix_ci"
        }
      },
      "requires": {
        "commands": [
          "gh"
        ]
      }
    }
  ]
}
